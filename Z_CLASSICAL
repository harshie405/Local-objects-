"EX3
TYPES: BEGIN OF lty_data,
         order_number      TYPE ydedno_12,
         order_item_number TYPE yitem_12,
         pm                TYPE ypm_12,
         ta                TYPE yta_12,
         item_cost         TYPE yitem_cos,
       END OF lty_data.

DATA: lv_ono  TYPE ydedno_12,
      lt_data TYPE STANDARD TABLE OF lty_data.

SELECT-OPTIONS: s_ono FOR lv_ono.

SELECT order_number order_item_number  pm ta
  FROM yordh
  INTO TABLE lt_data
  WHERE order_number IN s_ono.



*SELECT a~vbeln,a~rplnr, a~audat , a~netwr, b~posnr, b~wavwr
